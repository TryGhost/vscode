{
  "extends": [
    "@tryghost:quietJS"
  ],
  "packageRules": [
    {
      "description": "Automerge safe dependency updates after CI passes",
      "matchUpdateTypes": [
        "digest",
        "lockFileMaintenance",
        "minor",
        "patch",
        "pin"
      ],
      "automerge": true
    }
  ]
}
